{
  "name": "agentpulse",
  "version": "1.0.0",
  "description": "Local-first multi-model token usage tracker and multi-agent collaboration observatory",
  "type": "module",
  "bin": {
    "agentpulse": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "scripts/launch.mjs",
    "start.command",
    "start.bat",
    "README.md"
  ],
  "keywords": [
    "copilot",
    "tokens",
    "multi-agent",
    "telemetry",
    "opentelemetry",
    "observability"
  ],
  "scripts": {
    "setup": "npm install && npm --prefix web install && npm run build",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:server && npm run build:web",
    "dev:server": "tsx watch src/cli.ts start --no-open",
    "dev:web": "npm --prefix web run dev",
    "launch": "node scripts/launch.mjs",
    "start": "node dist/cli.js start",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
